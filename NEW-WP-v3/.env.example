# ── Firebase (client SDK — safe to expose, used in the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (server-only secret — from a service account JSON:
#    Firebase Console → Project Settings → Service Accounts → Generate new private key) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM private key. If pasting on one line, keep the \n escapes —
# the app un-escapes them automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Agora (video/voice calls & live streaming) ──
# App ID is safe to expose to the client; the certificate must stay server-only.
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── OxaPay (crypto payments — coin purchases & withdrawals) ──
OXA_PAY_API_KEY=
OXA_PAY_BASE_URL=https://api.oxapay.com
# Secret used to verify OxaPay's webhook HMAC signature.
# If OxaPay signs webhooks with your merchant API key instead of a separate
# secret, this can be left unset — the webhook route falls back to OXA_PAY_API_KEY.
OXA_PAY_WEBHOOK_SECRET=
OXA_PAY_PAYOUT_CALLBACK_URL=

# ── App URL (used to build OxaPay return/callback links) ──
NEXT_PUBLIC_BASE_URL=https://your-deployed-domain.com

# Admin panel — the only account allowed to access /admin
ADMIN_EMAIL=supunsasmithafamily@gmail.com
