rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ── users/{uid} — profile, coin balance, etc. ──
    match /users/{uid} {
      // Anyone signed in can read profiles (needed to show "People" lists,
      // gift sender names, etc.)
      allow read: if isSignedIn();
      // Only the account owner can create/update their own profile.
      // Balance-changing fields are actually written server-side by the
      // Admin SDK (which bypasses these rules entirely), so this only
      // governs direct client writes like updating displayName/photoURL.
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── chats/{chatId} — 1:1 conversations ──
    match /chats/{chatId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ── liveStreams/{streamId} — live broadcasts ──
    match /liveStreams/{streamId} {
      // Anyone signed in can see who's live and watch.
      allow read: if isSignedIn();
      // Only the host can create/update/end their own stream doc.
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn();
      // (update is left open rather than host-only because viewers need to
      // bump viewerCount on someone else's stream doc when they join/leave —
      // tighten this with a Cloud Function if you need stricter control.)
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Real-time live chat — anyone signed in can post/read while watching.
      match /chat/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      }

      // Gift events — written by the server (Admin SDK, which bypasses these
      // rules), so clients only ever need to read them for the live animation.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── callRecords/{id} — call history, written by the server (Admin SDK) ──
    match /callRecords/{id} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.partnerId == request.auth.uid);
      allow write: if false;
    }

    // ── coinTransactions/{id} — written by the server (Admin SDK) only ──
    match /coinTransactions/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── pendingPayments/{id} — OxaPay webhook bookkeeping, server-only ──
    match /pendingPayments/{id} {
      allow read, write: if false;
    }

    // ── withdrawRequests/{id} — created by /api/oxapay/payout (Admin SDK),
    // approved/rejected by the admin panel (Admin SDK) — both bypass these
    // rules entirely. Clients may only read their own requests.
    match /withdrawRequests/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
